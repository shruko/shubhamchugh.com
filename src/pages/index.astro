---
import Layout from "../layouts/Layout.astro";

const skills = [
  { category: "Languages & Frameworks", items: ["PHP", "Laravel", "React.js", "Vue.js", "JavaScript", "HTML/CSS"] },
  { category: "CMS & E-commerce",       items: ["WordPress", "WooCommerce", "Elementor", "ACF"] },
  { category: "Paid Advertising",        items: ["Meta Ads", "Google Ads", "Instagram Ads", "Retargeting"] },
  { category: "Analytics & Tracking",    items: ["GA4", "Search Console", "GTM", "Meta Pixel"] },
  { category: "SEO & Growth",            items: ["On-Page SEO", "Technical SEO", "Link Building", "Content Strategy"] },
  { category: "Infrastructure",          items: ["Linux/VPS", "Nginx", "Apache", "MySQL", "Redis", "Cloudflare"] },
];

const projects = [
  {
    name: "WinkSend",
    tagline: "Instagram automation for creators & agencies",
    desc: "Auto-reply to DMs and comments on Instagram. Built for creators, agencies, and social media teams who need to scale engagement without manual effort.",
    stack: ["Laravel", "React.js", "MySQL", "Instagram API"],
    status: "live",
    statusLabel: "Live",
    year: "2024 – Present",
    type: "SaaS",
    url: "https://www.winksend.com",
  },
  {
    name: "Toolboro",
    tagline: "Crowdsourced tools discovery platform",
    desc: "A Product Hunt–style discovery platform for tools — crowdsourced submissions, upvotes, and reviews to help people find the best tools for the job.",
    stack: ["Laravel", "React.js", "MySQL"],
    status: "live",
    statusLabel: "Live",
    year: "2024 – Present",
    type: "SaaS",
    url: "https://www.toolboro.com",
  },
  {
    name: "TechnoFizi",
    tagline: "One of India's top tech blogs",
    desc: "Built and scaled technofizi.net to become one of India's leading tech publications — hundreds of thousands of organic visitors, top Google rankings, and a full ad revenue model. Disrupted by LLMs, pivoted to SaaS.",
    stack: ["WordPress", "SEO", "Google Ads", "AdSense", "Cloudflare"],
    status: "archive",
    statusLabel: "Past",
    year: "2017 – 2023",
    type: "Own project",
    url: null,
  },
];

const adServices = [
  {
    title: "Google Ads",
    sub: "Search · Display · Shopping",
    desc: "Full campaign setup — keyword research, bidding strategy, ad copy, A/B testing, and ongoing optimization to lower your cost per acquisition.",
    points: ["Search & Shopping Campaigns", "Display & Remarketing", "Conversion Tracking", "Budget Optimization"],
    color: "#4285F4",
  },
  {
    title: "Meta Ads",
    sub: "Facebook · Instagram",
    desc: "Audience building, creative strategy, and funnel setup across Facebook and Instagram — from brand awareness to direct-response campaigns.",
    points: ["Audience & Interest Targeting", "Lookalike Audiences", "Retargeting Funnels", "Pixel & Event Setup"],
    color: "#1877F2",
  },
  {
    title: "Analytics & SEO",
    sub: "GA4 · Search Console · GTM",
    desc: "Proper tracking setup so you know exactly what's working. GA4, GTM, conversion events, plus organic SEO strategy built on 6+ years of experience.",
    points: ["GA4 & GTM Configuration", "Conversion Event Tracking", "Technical SEO Audits", "Search Console Optimization"],
    color: "#E37400",
  },
];
---

<Layout>
  <!-- ═══════════════════════════════════════
       NAVIGATION
  ═══════════════════════════════════════ -->
  <nav
    id="nav"
    class="fixed top-0 left-0 right-0 z-50 h-16 flex items-center px-8 justify-between
           border-b border-transparent
           transition-all duration-300"
    style="font-family: var(--font-sans);"
  >
    <a
      href="/"
      class="text-[var(--color-fg-1)] hover:text-[var(--color-fg-1)] transition-none"
      style="font-family: var(--font-display); font-size: 20px; font-weight: 700; letter-spacing: -0.02em;"
    >
      <span style="color: var(--color-accent);">S</span>hubham Chugh
    </a>

    <div class="hidden md:flex items-center gap-7">
      {[["building", "Building"], ["marketing", "Marketing"], ["background", "Background"]].map(([id, label]) => (
        <button
          data-scroll={id}
          class="nav-btn text-sm text-[var(--color-fg-2)] hover:text-[var(--color-fg-1)] transition-colors duration-150 bg-transparent border-none cursor-pointer p-0"
          style="font-family: var(--font-sans); letter-spacing: 0.01em;"
        >
          {label}
        </button>
      ))}
      <a
        href="mailto:hey@shubhamchugh.com"
        class="text-xs font-medium text-[var(--color-accent)] hover:bg-[rgba(232,98,42,0.12)] border border-[rgba(232,98,42,0.35)] hover:border-[var(--color-accent)] px-4 py-1.5 rounded-lg transition-all duration-150"
        style="font-family: var(--font-sans); font-size: 13px;"
      >
        Get in touch ↗
      </a>
    </div>

    <button
      id="navToggle"
      class="md:hidden flex flex-col gap-1.5 p-1 bg-transparent border-none cursor-pointer"
      aria-label="Menu"
    >
      <span class="block w-5 h-0.5 bg-[var(--color-fg-2)] rounded-sm"></span>
      <span class="block w-5 h-0.5 bg-[var(--color-fg-2)] rounded-sm"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobileMenu"
    class="hidden fixed top-16 left-0 right-0 z-40 bg-[var(--color-bg)] border-b border-[var(--color-border)] px-8 py-5 flex-col gap-4"
    style="font-family: var(--font-sans);"
  >
    <a href="#building"   class="mobile-nav-link text-base text-[var(--color-fg-2)] hover:text-[var(--color-fg-1)] transition-colors">Building</a>
    <a href="#marketing"  class="mobile-nav-link text-base text-[var(--color-fg-2)] hover:text-[var(--color-fg-1)] transition-colors">Marketing</a>
    <a href="#background" class="mobile-nav-link text-base text-[var(--color-fg-2)] hover:text-[var(--color-fg-1)] transition-colors">Background</a>
    <a href="mailto:hey@shubhamchugh.com" class="text-sm text-[var(--color-accent)]">hey@shubhamchugh.com ↗</a>
  </div>

  <!-- ═══════════════════════════════════════
       MAIN CONTENT
  ═══════════════════════════════════════ -->
  <main class="max-w-[720px] mx-auto px-6" style="padding-top: 0;">

    <!-- ── HERO ───────────────────────────── -->
    <section class="min-h-screen flex items-center" style="padding: 120px 0 96px;">
      <div class="w-full">

        <div class="hero-item mb-8" style="transition-delay: 0ms;">
          <div
            class="w-24 h-24 rounded-full overflow-hidden border-2"
            style="background: var(--color-raised); border-color: var(--color-border);"
          >
            <img src="/avatar.jpg" alt="Shubham Chugh" class="w-full h-full object-cover object-top" width="96" height="96" />
          </div>
        </div>

        <div class="hero-item mb-1" style="transition-delay: 80ms;">
          <span class="text-[var(--color-fg-2)]" style="font-family: var(--font-sans); font-size: 18px; font-weight: 400; letter-spacing: 0.01em;">Hi, I'm</span>
        </div>

        <div class="hero-item" style="transition-delay: 160ms; margin-bottom: 4px;">
          <div style="font-family: var(--font-display); font-size: clamp(56px, 10vw, 96px); font-weight: 700; color: var(--color-accent); letter-spacing: -0.03em; line-height: 1.0;">Shubham</div>
          <div style="font-family: var(--font-display); font-size: clamp(56px, 10vw, 96px); font-weight: 700; color: var(--color-fg-1); letter-spacing: -0.03em; line-height: 1.0;">Chugh.</div>
        </div>

        <div class="hero-item mt-7 mb-5" style="transition-delay: 280ms;">
          <p class="text-[var(--color-fg-2)] max-w-[540px]" style="font-family: var(--font-sans); font-size: 20px; font-weight: 400; line-height: 1.6;">
            Developer and marketer. Right now I'm building{" "}
            <a href="https://www.winksend.com" target="_blank" rel="noopener" class="accent-link" style="color: var(--color-accent); border-bottom: 1px solid rgba(232,98,42,0.35);">WinkSend</a>
            {" "}and{" "}
            <a href="https://www.toolboro.com" target="_blank" rel="noopener" class="accent-link" style="color: var(--color-accent); border-bottom: 1px solid rgba(232,98,42,0.35);">Toolboro</a>
            {" "}— and helping brands grow with Google & Meta ads.
          </p>
        </div>

        <div class="hero-item flex flex-wrap gap-2 mb-9" style="transition-delay: 360ms;">
          {["Laravel", "Meta Ads", "Google Ads", "SEO", "WordPress", "Analytics"].map((tech) => (
            <span
              class="text-[var(--color-fg-3)] border border-[var(--color-border)]"
              style="font-family: var(--font-mono); font-size: 12px; background: var(--color-raised); padding: 4px 10px; border-radius: 6px;"
            >{tech}</span>
          ))}
        </div>

        <div class="hero-item flex flex-wrap gap-6 items-center" style="transition-delay: 440ms;">
          {[
            ["GitHub",    "https://github.com/theshubhamchugh"],
            ["YouTube",   "https://www.youtube.com/@theshubhamchugh"],
            ["Twitter/X", "https://x.com/theshubhamchugh"],
            ["Email",     "mailto:hey@shubhamchugh.com"],
          ].map(([label, href]) => (
            <a
              href={href}
              target={href.startsWith("mailto") ? undefined : "_blank"}
              rel="noopener"
              class="social-link text-[var(--color-fg-2)] hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1"
              style="font-family: var(--font-sans); font-size: 14px;"
            >{label} ↗</a>
          ))}
        </div>

      </div>
    </section>

    <!-- ── PROJECTS ──────────────────────── -->
    <section id="building" class="py-24 reveal">
      <h2 class="text-[var(--color-fg-3)] mb-8 tracking-[0.12em] uppercase" style="font-family: var(--font-sans); font-size: 13px; font-weight: 600;">What I've Built</h2>
      <div class="flex flex-col gap-4">
        {projects.map((p, i) => {
          const isLive = p.status === "live";
          return (
            <div
              class={`project-card reveal reveal-d${Math.min(i + 1, 4)} bg-[var(--color-raised)] border border-[var(--color-border)] rounded-xl transition-all duration-250 ${p.url ? "cursor-pointer" : ""}`}
              style={`padding: ${i === 0 ? "28px" : "24px"};`}
              data-url={p.url || ""}
            >
              <div class="flex justify-between items-start mb-3">
                <div>
                  <div class="flex items-center gap-2.5 mb-1.5">
                    <h3 class="text-[var(--color-fg-1)]" style={`font-family: var(--font-sans); font-size: ${i === 0 ? "20px" : "17px"}; font-weight: 600;`}>
                      {p.url ? <a href={p.url} target="_blank" rel="noopener" style="color: inherit;">{p.name}</a> : p.name}
                    </h3>
                    <span
                      class="text-[10px] font-semibold tracking-[0.04em] uppercase px-2 py-0.5 rounded-full whitespace-nowrap"
                      style={isLive
                        ? "color: #4ade80; background: rgba(74,222,128,0.10); border: 1px solid rgba(74,222,128,0.25);"
                        : "color: var(--color-fg-2); background: var(--color-raised); border: 1px solid var(--color-border);"}
                    >{p.statusLabel}</span>
                  </div>
                  <p class="text-[var(--color-fg-3)]" style="font-family: var(--font-sans); font-size: 13px;">{p.type} · {p.year}</p>
                </div>
                {p.url && <span class="card-arrow text-[var(--color-border-em)] transition-colors duration-150 text-lg">↗</span>}
              </div>
              <p class="text-[var(--color-fg-2)] mb-4" style="font-family: var(--font-sans); font-size: 13px; font-weight: 500;">{p.tagline}</p>
              <p class="text-[var(--color-fg-2)] mb-4" style="font-family: var(--font-sans); font-size: 15px; line-height: 1.65;">{p.desc}</p>
              <div class="flex flex-wrap gap-1.5">
                {p.stack.map((tech) => (
                  <span class="text-[var(--color-fg-3)] border border-[var(--color-border)]" style="font-family: var(--font-mono); font-size: 11px; background: var(--color-surface); padding: 3px 8px; border-radius: 5px;">{tech}</span>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- ── MARKETING & ADS ───────────────── -->
    <section id="marketing" class="py-24 border-t border-[var(--color-border)] reveal">

      <h2 class="text-[var(--color-fg-3)] mb-4 tracking-[0.12em] uppercase" style="font-family: var(--font-sans); font-size: 13px; font-weight: 600;">Marketing & Paid Ads</h2>

      <p class="text-[var(--color-fg-2)] mb-3 max-w-[560px] reveal reveal-d1" style="font-family: var(--font-sans); font-size: 18px; line-height: 1.7;">
        I grew TechnoFizi to one of India's top tech blogs purely through SEO and content — before moving into paid performance marketing.
      </p>
      <p class="text-[var(--color-fg-2)] mb-12 max-w-[560px] reveal reveal-d2" style="font-family: var(--font-sans); font-size: 15px; line-height: 1.75; color: var(--color-fg-3);">
        I approach ads as a system: the right audience, compelling creatives, proper pixel and conversion tracking, and continuous data-driven optimization. Whether you need Google search campaigns or Meta retargeting funnels — I've done it.
      </p>

      <!-- Service cards -->
      <div class="grid gap-4 mb-14 reveal reveal-d2" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
        {adServices.map((s) => (
          <div
            class="bg-[var(--color-raised)] border border-[var(--color-border)] rounded-xl p-5 flex flex-col gap-3 transition-all duration-250 service-card"
          >
            <div>
              <div class="flex items-center gap-2 mb-0.5">
                <span
                  class="inline-block w-2 h-2 rounded-full"
                  style={`background: ${s.color};`}
                ></span>
                <h3 class="text-[var(--color-fg-1)] font-semibold" style="font-family: var(--font-sans); font-size: 15px;">{s.title}</h3>
              </div>
              <p class="text-[var(--color-fg-3)]" style="font-family: var(--font-mono); font-size: 11px;">{s.sub}</p>
            </div>
            <p class="text-[var(--color-fg-2)]" style="font-family: var(--font-sans); font-size: 13px; line-height: 1.6;">{s.desc}</p>
            <ul class="flex flex-col gap-1 mt-auto">
              {s.points.map((pt) => (
                <li class="flex items-start gap-2 text-[var(--color-fg-3)]" style="font-family: var(--font-sans); font-size: 12px;">
                  <span style={`color: ${s.color}; font-size: 10px; margin-top: 3px; flex-shrink: 0;`}>▸</span>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Tool icons -->
      <div class="mb-6 reveal reveal-d3">
        <p class="text-[var(--color-fg-3)] mb-5 uppercase tracking-[0.1em]" style="font-family: var(--font-sans); font-size: 11px; font-weight: 600;">Tools I work with daily</p>
        <div class="grid gap-3" style="grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));">

          <!-- Google Ads -->
          <div class="tool-icon-card flex flex-col items-center gap-2 p-4 bg-[var(--color-raised)] border border-[var(--color-border)] rounded-xl transition-all duration-200">
            <div class="w-10 h-10 flex items-center justify-center">
              <svg viewBox="0 0 24 24" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
            </div>
            <span class="text-[var(--color-fg-3)] text-center" style="font-family: var(--font-sans); font-size: 10px; line-height: 1.3;">Google Ads</span>
          </div>

          <!-- Meta Ads -->
          <div class="tool-icon-card flex flex-col items-center gap-2 p-4 bg-[var(--color-raised)] border border-[var(--color-border)] rounded-xl transition-all duration-200">
            <div class="w-10 h-10 flex items-center justify-center">
              <svg viewBox="0 0 24 24" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" fill="#1877F2"/>
              </svg>
            </div>
            <span class="text-[var(--color-fg-3)] text-center" style="font-family: var(--font-sans); font-size: 10px; line-height: 1.3;">Meta Ads</span>
          </div>

          <!-- Google Analytics 4 -->
          <div class="tool-icon-card flex flex-col items-center gap-2 p-4 bg-[var(--color-raised)] border border-[var(--color-border)] rounded-xl transition-all duration-200">
            <div class="w-10 h-10 flex items-center justify-center">
              <svg viewBox="0 0 40 40" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4"  y="22" width="8" height="14" rx="2" fill="#E37400"/>
                <rect x="16" y="13" width="8" height="23" rx="2" fill="#F9AB00"/>
                <rect x="28" y="4"  width="8" height="32" rx="2" fill="#E37400"/>
              </svg>
            </div>
            <span class="text-[var(--color-fg-3)] text-center" style="font-family: var(--font-sans); font-size: 10px; line-height: 1.3;">Analytics 4</span>
          </div>

          <!-- Google Search Console -->
          <div class="tool-icon-card flex flex-col items-center gap-2 p-4 bg-[var(--color-raised)] border border-[var(--color-border)] rounded-xl transition-all duration-200">
            <div class="w-10 h-10 flex items-center justify-center">
              <svg viewBox="0 0 40 40" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="17" cy="17" r="10" stroke="#4285F4" stroke-width="3"/>
                <circle cx="17" cy="17" r="4"  fill="#EA4335"/>
                <path d="M24 24L35 35" stroke="#34A853" stroke-width="3.5" stroke-linecap="round"/>
              </svg>
            </div>
            <span class="text-[var(--color-fg-3)] text-center" style="font-family: var(--font-sans); font-size: 10px; line-height: 1.3;">Search Console</span>
          </div>

          <!-- Google Tag Manager -->
          <div class="tool-icon-card flex flex-col items-center gap-2 p-4 bg-[var(--color-raised)] border border-[var(--color-border)] rounded-xl transition-all duration-200">
            <div class="w-10 h-10 flex items-center justify-center">
              <svg viewBox="0 0 40 40" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 6h18l10 14-10 14H6z" fill="#246FDB" rx="3"/>
                <circle cx="20" cy="20" r="5" fill="white"/>
                <circle cx="20" cy="20" r="2.5" fill="#246FDB"/>
              </svg>
            </div>
            <span class="text-[var(--color-fg-3)] text-center" style="font-family: var(--font-sans); font-size: 10px; line-height: 1.3;">Tag Manager</span>
          </div>

          <!-- WordPress -->
          <div class="tool-icon-card flex flex-col items-center gap-2 p-4 bg-[var(--color-raised)] border border-[var(--color-border)] rounded-xl transition-all duration-200">
            <div class="w-10 h-10 flex items-center justify-center">
              <svg viewBox="0 0 24 24" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm0 19.5c-5.247 0-9.5-4.253-9.5-9.5S6.753 2.5 12 2.5s9.5 4.253 9.5 9.5-4.253 9.5-9.5 9.5z" fill="#21759B"/>
                <path d="M3.543 12c0 3.603 2.097 6.731 5.14 8.232L4.165 9.245A8.45 8.45 0 003.543 12zm14.39-.823c0-1.124-.404-1.903-.75-2.509-.46-.749-.893-1.383-.893-2.132 0-.835.634-1.613 1.527-1.613.04 0 .079.005.118.007A8.453 8.453 0 0012 3.543c-2.957 0-5.554 1.516-7.07 3.81.199.006.386.01.546.01 1.24 0 3.161-.15 3.161-.15.639-.038.714.9.076.975 0 0-.643.076-1.359.113l4.323 12.852 2.598-7.785-1.85-5.067c-.639-.037-1.245-.113-1.245-.113-.639-.038-.564-1.013.075-.975 0 0 1.96.15 3.124.15 1.241 0 3.162-.15 3.162-.15.64-.038.715.9.076.975 0 0-.644.076-1.358.113l4.29 12.764.185-.617c.6-1.928.955-3.31.955-4.491z" fill="#21759B"/>
                <path d="M12.337 12.902l-3.562 10.35c1.064.313 2.187.481 3.348.481a8.468 8.468 0 003.506-.754 1.24 1.24 0 01-.09-.174l-3.202-8.903zm7.325-4.83a6.59 6.59 0 01.058.866c0 .854-.16 1.814-.639 3.014l-2.565 7.415c2.498-1.456 4.176-4.14 4.176-7.224a8.42 8.42 0 00-1.03-4.07z" fill="#21759B"/>
              </svg>
            </div>
            <span class="text-[var(--color-fg-3)] text-center" style="font-family: var(--font-sans); font-size: 10px; line-height: 1.3;">WordPress</span>
          </div>

          <!-- Meta Pixel -->
          <div class="tool-icon-card flex flex-col items-center gap-2 p-4 bg-[var(--color-raised)] border border-[var(--color-border)] rounded-xl transition-all duration-200">
            <div class="w-10 h-10 flex items-center justify-center">
              <svg viewBox="0 0 40 40" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4"  y="4"  width="14" height="14" rx="3" fill="#1877F2"/>
                <rect x="22" y="4"  width="14" height="14" rx="3" fill="#1877F2" opacity=".6"/>
                <rect x="4"  y="22" width="14" height="14" rx="3" fill="#1877F2" opacity=".6"/>
                <rect x="22" y="22" width="14" height="14" rx="3" fill="#1877F2" opacity=".3"/>
              </svg>
            </div>
