<style>
  .policy-content {
    color: var(--color-fg-2);
    font-size: 15px;
    line-height: 1.8;
  }
  .policy-content h2 {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-fg-1);
    margin-top: 40px;
    margin-bottom: 12px;
  }
  .policy-content h3 {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-fg-2);
    margin-top: 20px;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .policy-content p {
    margin-bottom: 16px;
  }
  .policy-content ul {
    margin-bottom: 16px;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .policy-content ul li {
    list-style: disc;
    padding-left: 4px;
  }
  .policy-content a {
    color: var(--color-accent);
    border-bottom: 1px solid rgba(232,98,42,0.3);
    transition: border-color 150ms ease;
  }
  .policy-content a:hover {
    border-bottom-color: var(--color-accent);
  }
  .policy-content strong {
    color: var(--color-fg-1);
    font-weight: 600;
  }
</style>
